      "seed": 1686787967,
      "version": 1,
      "versionNonce": 1555945718,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754800000000,
      "link": null,
      "locked": false,
      "text": "If the client lost its local manifest (reinstall / new device):  GET /uploads?contentHash=\u2026  \u2192 server's own pending rows.   Never resumed?  blob lifecycle aborts incomplete multipart uploads after ~7d (you ARE billed for orphaned parts) and GC drops the pending row.\nChunk size is a RESUME tradeoff, not just throughput: a dropped connection wastes one whole part \u2014 mobile-heavy clients argue for the 5 MB end.",
      "originalText": "If the client lost its local manifest (reinstall / new device):  GET /uploads?contentHash=\u2026  \u2192 server's own pending rows.   Never resumed?  blob lifecycle aborts incomplete multipart uploads after ~7d (you ARE billed for orphaned parts) and GC drops the pending row.\nChunk size is a RESUME tradeoff, not just throughput: a dropped connection wastes one whole part \u2014 mobile-heavy clients argue for the 5 MB end.",
      "fontSize": 12,
      "fontFamily": 3,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
    {
      "id": "el0138",
      "type": "text",
      "x": 20,
      "y": 1840,
      "width": 1420,
      "height": 30.0,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "roundness": null,
      "seed": 1361478851,
      "version": 1,
      "versionNonce": 967517691,
      "isDeleted": false,
      "boundElements": [],
      "updated": 1754800000000,
      "link": null,
      "locked": false,
      "text": "Download fails mid-transfer \u2014 resume path (HTTP Range, RFC 7233)",
      "originalText": "Download fails mid-transfer \u2014 resume path (HTTP Range, RFC 7233)",
      "fontSize": 24,
      "fontFamily": 1,
      "textAlign": "center",
      "verticalAlign": "top",
      "containerId": null,
      "lineHeight": 1.25,
      "autoResize": false
    },
